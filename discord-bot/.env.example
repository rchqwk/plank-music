DISCORD_TOKEN=replace-with-bot-token
DISCORD_CLIENT_ID=replace-with-application-id
# Optional: registering to one guild makes slash commands update immediately.
DISCORD_GUILD_ID=
BACKEND_URL=http://localhost:4000
# Defaults to the guild ID, keeping each Discord server's queue independent.
PLAYER_ID_PREFIX=
# Set true only after enabling Message Content Intent in the Discord Developer Portal.
# This enables the `\\p song name` prefix shortcut; slash commands work without it.
ENABLE_MESSAGE_CONTENT=false

PLAYER_BOT_TOKEN=matching-backend-control-key-at-least-32-characters
