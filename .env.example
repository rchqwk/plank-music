# HTTP port for this backend
PORT=4000

# Invidious instance (any public or self-hosted instance).
# IMPORTANT: many public instances have their public API disabled. Pick one
# with "api": true from the list, or self-host for reliability:
#   https://api.invidious.io/instances.json
INVIDIOUS_INSTANCE=https://inv.nadeko.net
INVIDIOUS_REGION=US

# Lavalink node (see docker-compose.yml / application.yml)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Lavalink WebSocket handshake identity.
# CLIENT_USER_ID maps to the "bot user id" header and MUST be numeric
# (Lavalink v4 parses it as a number).
CLIENT_NAME=invidious-music-backend/1.0.0
CLIENT_USER_ID=170939974227541168

# Stable production session signing key and a shared backend/bot control key.
PLAYER_SESSION_SECRET=replace-with-at-least-32-random-characters
PLAYER_BOT_TOKEN=replace-with-at-least-32-random-characters
